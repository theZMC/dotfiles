// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "model": "openai/gpt-5.6-terra"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "provider": "copilot"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_family": "RecMonoCasual Nerd Font Mono",
  "buffer_font_size": 15,
  "terminal": {
    // Match ghostty (font-family / font-size; config.local bumps size to 16 on this machine)
    "font_family": "RecMonoCasual Nerd Font Mono",
    "font_size": 16,
    // Ghostty renders with the font's native metrics; Zed's default "comfortable"
    // (1.618) is much taller — "standard" (1.3) is the closest match
    "line_height": "standard",
    // Zed nudges terminal colors toward higher contrast by default; disable so
    // the ghostty palette below renders exactly as specified
    "minimum_contrast": 0,
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "theme_overrides": {
    "One Dark": {
      // Terminal colors copied from .config/ghostty/config
      "terminal.background": "#1A1D23",
      "terminal.foreground": "#ADB0BB",
      "terminal.ansi.black": "#111317",
      "terminal.ansi.bright_black": "#34363A",
      "terminal.ansi.red": "#FF838B",
      "terminal.ansi.bright_red": "#FFA6AE",
      "terminal.ansi.green": "#87C05F",
      "terminal.ansi.bright_green": "#AAE382",
      "terminal.ansi.yellow": "#DFAB25",
      "terminal.ansi.bright_yellow": "#FFCE48",
      "terminal.ansi.blue": "#5EB7FF",
      "terminal.ansi.bright_blue": "#81DAFF",
      "terminal.ansi.magenta": "#DD97F1",
      "terminal.ansi.bright_magenta": "#FFBAFF",
      "terminal.ansi.cyan": "#4AC2B8",
      "terminal.ansi.bright_cyan": "#6DE5DB",
      "terminal.ansi.white": "#9B9FA9",
      "terminal.ansi.bright_white": "#D0D3DE",
    },
  },
}
